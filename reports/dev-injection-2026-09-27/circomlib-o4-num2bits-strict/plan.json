  "mutant_edit": {
    "find": "    component aliasCheck = AliasCheck();\n    component n2b = Num2Bits(254);\n    in ==> n2b.in;\n\n    for (var i=0; i<254; i++) {\n        n2b.out[i] ==> out[i];\n        n2b.out[i] ==> aliasCheck.in[i];\n    }\n",
    "replace": "    var lc1 = 0;\n    var e2 = 1;\n    for (var i=0; i<254; i++) {\n        out[i] <-- (in >> i) & 1;\n        out[i] * (out[i] - 1) === 0;\n        lc1 += out[i] * e2;\n        e2 = e2 + e2;\n    }\n    lc1 === in;\n"
  },
  "twin_edit": {
    "find": "    var e2 = 1;\n    for (var i=0; i<254; i++) {\n        out[i] <-- (in >> i) & 1;\n",
    "replace": "    var e2 = 1;\n    var carry = 1;\n    for (var i=0; i<254; i++) {\n        var digit = ((in >> i) & 1) + ((-1 >> i) & 1) + carry;\n        out[i] <-- digit & 1;\n        carry = digit \\ 2;\n"
  },
